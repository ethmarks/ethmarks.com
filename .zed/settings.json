{
  "lsp": {
    "deno": {
      "settings": {
        "deno": {
          "enable": true,
        },
      },
    },
  },
  "languages": {
    "JavaScript": {
      "language_servers": ["dprint", "deno", "hackatime"],
      "formatter": "language_server",
    },
    "TypeScript": {
      "language_servers": ["dprint", "deno", "hackatime"],
      "formatter": "language_server",
    },
    "TSX": {
      "language_servers": [
        "dprint",
        "deno",
        "hackatime",
      ],
      "formatter": "language_server",
    },
  },
  "formatter": {
    "external": {
      "command": "dprint",
      "arguments": ["fmt", "--stdin", "{buffer_path}"],
    },
  },
}
